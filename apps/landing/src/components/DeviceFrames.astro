---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
	desktop: ImageMetadata;
	desktopAlt: string;
	mobile?: ImageMetadata;
	mobileAlt?: string;
	windowTitle: string;
	phoneSide?: "left" | "right";
	phoneInside?: boolean;
	eager?: boolean;
}

const {
	desktop,
	desktopAlt,
	mobile,
	mobileAlt = "",
	windowTitle,
	phoneSide = "right",
	phoneInside = false,
	eager = false
} = Astro.props;

const phoneOffsets = {
	left: phoneInside ? "left-[4%]" : "left-[-2%] xl:left-[-6%]",
	right: phoneInside ? "right-[4%]" : "right-[-2%] xl:right-[-6%]"
};
const phoneOffsetClass = phoneOffsets[phoneSide];
const loading = eager ? "eager" : "lazy";
const fetchpriority = eager ? "high" : "auto";
---

<div class="relative" class:list={[mobile && "pb-10 sm:pb-14"]}>
	<div
		class="relative rounded-xl sm:rounded-2xl overflow-hidden border border-[var(--color-line-strong)] bg-[var(--color-surface)]"
		style="box-shadow: 0 40px 80px -40px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,255,255,0.03) inset;"
	>
		<div
			class="flex items-center gap-3 px-3 sm:px-4 h-8 sm:h-9 border-b border-[var(--color-line)] bg-[#0f0f15]"
			aria-hidden="true"
		>
			<span class="flex gap-1.5">
				<span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
				<span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
				<span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
			</span>
			<span
				class="hidden sm:flex flex-1 max-w-xs mx-auto items-center justify-center h-5 rounded-md bg-[var(--color-surface-raised)] text-[0.6875rem] text-[var(--color-fg-muted)] truncate"
				>{windowTitle}</span
			>
		</div>
		<slot name="desktop">
			<Picture
				src={desktop}
				alt={desktopAlt}
				formats={["avif", "webp"]}
				fallbackFormat="webp"
				widths={[640, 960, 1440, 2160]}
				sizes="(min-width: 1280px) 760px, (min-width: 1024px) 60vw, 94vw"
				loading={loading}
				fetchpriority={fetchpriority}
				class="block w-full h-auto"
			/>
		</slot>
	</div>

	{
		mobile && (
			<div
				class="absolute bottom-0 w-[36%] sm:w-[26%] max-w-[200px] rounded-[1.4rem] sm:rounded-[2rem] p-[3px] sm:p-[5px] bg-[#0b0b10] border border-[var(--color-line-strong)]"
				class:list={[phoneOffsetClass]}
				style="box-shadow: 0 30px 60px -20px rgba(0,0,0,0.95), 0 0 0 1px rgba(255,255,255,0.04) inset;"
			>
				<div class="rounded-[1.15rem] sm:rounded-[1.6rem] overflow-hidden aspect-[390/844] bg-[var(--color-canvas)]">
					<Picture
						src={mobile}
						alt={mobileAlt}
						formats={["avif", "webp"]}
						fallbackFormat="webp"
						widths={[240, 360, 480]}
						sizes="(min-width: 1024px) 200px, 26vw"
						loading={loading}
						pictureAttributes={{ class: "block w-full h-full" }}
						class="block w-full h-full object-cover object-top"
					/>
				</div>
			</div>
		)
	}
</div>
