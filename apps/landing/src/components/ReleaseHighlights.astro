---
import { Picture } from "astro:assets";

import rewindStory from "../assets/screenshots/rewind-story-mobile.webp";

const highlights = [
	{
		icon: "emoji_events",
		title: "Platinos",
		description:
			"Marca los juegos que completaste al cien por ciento y lúcelos en una vitrina propia de tu perfil."
	},
	{
		icon: "collections_bookmark",
		title: "Sagas",
		description:
			"Explora las sagas del catálogo, sigue las que te importan y muéstralas en tu perfil."
	},
	{
		icon: "auto_awesome",
		title: "Duración y nota solas",
		description:
			"Al agregar un juego, Completr busca cuánto dura y qué nota tiene. Tú solo decides si lo juegas."
	},
	{
		icon: "download",
		title: "Tus datos son tuyos",
		description:
			"Descarga tu biblioteca o cualquier lista cuando quieras, en un archivo que abre cualquier planilla."
	}
];
---

<section
	id="v1"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute -top-40 -left-40 w-[700px] h-[700px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div class="relative max-w-6xl mx-auto">
		<div class="max-w-2xl mb-12">
			<span class="eyebrow">Novedades de la 1.0</span>
			<h2
				class="font-display mt-3 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
			>
				Más que un backlog: <span class="text-gradient"
					>tu año en juegos</span
				>.
			</h2>
			<p class="m-0 text-[var(--color-fg-secondary)] leading-relaxed">
				La 1.0 cierra la etapa en que Completr era solo una lista
				ordenada. Ahora también te cuenta qué jugaste, qué conseguiste y
				qué te falta.
			</p>
		</div>

		<div class="grid gap-4 lg:grid-cols-12">
			<article
				class="relative lg:col-span-7 lg:row-span-2 grid sm:grid-cols-[minmax(0,1fr)_minmax(0,15rem)] gap-8 items-center p-6 sm:p-10 rounded-3xl border border-[var(--color-brand)]/30 overflow-hidden"
				style="background: linear-gradient(160deg, rgba(139, 92, 246, 0.18), transparent 55%), radial-gradient(circle at 100% 100%, rgba(251, 146, 60, 0.14), transparent 55%), var(--color-surface);"
			>
				<div class="flex flex-col items-start gap-4">
					<span
						class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/30"
					>
						<span
							class="material-icons text-[0.875rem]"
							aria-hidden="true">history</span
						>
						Rewind
					</span>
					<h3
						class="font-display m-0 text-2xl md:text-4xl font-bold tracking-tight leading-tight text-balance"
					>
						Tu año en juegos, listo para <span
							class="rewind-gradient">compartir</span
						>.
					</h3>
					<p
						class="m-0 text-[var(--color-fg-secondary)] leading-relaxed"
					>
						Desde diciembre generas el resumen de tu año: lo que
						terminaste, lo que dejaste, tu mejor juego y el tipo de
						jugador que fuiste. Después lo subes a tus historias con
						un toque.
					</p>
					<ul
						class="m-0 p-0 list-none flex flex-col gap-2 text-sm text-[var(--color-fg-secondary)]"
					>
						<li class="inline-flex items-center gap-2">
							<span
								class="material-icons text-[1.125rem] text-[var(--color-brand)]"
								aria-hidden="true">auto_stories</span
							>
							En español o en inglés
						</li>
						<li class="inline-flex items-center gap-2">
							<span
								class="material-icons text-[1.125rem] text-[var(--color-brand)]"
								aria-hidden="true">ios_share</span
							>
							Imagen para historias y enlace con vista previa
						</li>
						<li class="inline-flex items-center gap-2">
							<span
								class="material-icons text-[1.125rem] text-[var(--color-brand)]"
								aria-hidden="true">lock</span
							>
							Tú decides quién lo ve
						</li>
					</ul>
				</div>

				<div class="relative mx-auto w-[min(15rem,70%)] sm:w-full">
					<div
						class="rewind-card relative rounded-[1.5rem] overflow-hidden border border-white/10"
						style="box-shadow: 0 40px 80px -30px rgba(0,0,0,0.95), 0 0 60px -20px var(--color-brand-glow);"
					>
						<Picture
							src={rewindStory}
							alt="Imagen del Rewind 2026 lista para compartir: las portadas del año, los juegos terminados, el tipo de jugador y las horas jugadas"
							formats={["avif", "webp"]}
							fallbackFormat="webp"
							widths={[240, 360, 480, 720]}
							sizes="(min-width: 1024px) 240px, 60vw"
							class="block w-full h-auto"
						/>
					</div>
				</div>
			</article>

			<ul
				class="lg:col-span-5 lg:row-span-2 m-0 p-0 list-none grid sm:grid-cols-2 gap-4"
			>
				{
					highlights.map(item => (
						<li class="flex flex-col gap-3 p-6 rounded-2xl border border-[var(--color-line)] bg-[var(--color-surface)] transition-colors hover:border-[var(--color-line-strong)]">
							<span
								class="flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--color-brand)]/15 text-[var(--color-brand)]"
								aria-hidden="true"
							>
								<span class="material-icons text-[1.375rem]">
									{item.icon}
								</span>
							</span>
							<h3 class="font-display m-0 text-base font-bold text-[var(--color-fg)]">
								{item.title}
							</h3>
							<p class="m-0 text-sm text-[var(--color-fg-secondary)] leading-relaxed">
								{item.description}
							</p>
						</li>
					))
				}
			</ul>
		</div>

		<a
			href="/changelog"
			class="mt-8 inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--color-brand)] no-underline hover:text-[var(--color-fg)] transition-colors"
		>
			Ver todo lo nuevo en el changelog
			<span class="material-icons text-[1rem]" aria-hidden="true"
				>arrow_forward</span
			>
		</a>
	</div>
</section>

<style>
	.rewind-gradient {
		background-image: linear-gradient(90deg, #a78bfa, #f472b6, #fb923c);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.rewind-card {
		transform: rotate(3deg);
		transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.rewind-card:hover {
		transform: rotate(0deg) translateY(-4px);
	}
</style>
