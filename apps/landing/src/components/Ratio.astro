---
import { type Locale, toLocale } from "../i18n/locales";

const lang = toLocale(Astro.currentLocale);

const ratioScale = 20;
const score = 4.75;
const stars = ["star", "star", "star", "star", "star_half"];
const blockBackground =
	"background: linear-gradient(90deg, var(--color-brand-deep), var(--color-brand));";
const ratioOf = (hours: number) =>
	(Math.round((score / hours) * ratioScale * 10) / 10).toFixed(1);

const copy = {
	es: {
		eyebrow: "El Ratio",
		titleStart: "Lo que cabe en",
		titleHighlight: "tu tiempo",
		introStart: "El",
		introAnswer: "responde la pregunta de cada noche:",
		introQuestion: "¿qué juego ahora?",
		introPoints: "No dice qué juego es mejor: te señala",
		introHighlight: "los buenos que se terminan pronto",
		introEnd: ", para que elijas según el tiempo que tengas.",
		afterFinish:
			"Y cuando terminas un juego, te cuenta si te rindió más o menos de lo que esperabas.",
		formulaRating: "Nota",
		formulaHours: "Horas",
		dividedBy: "dividido por",
		times: "por",
		equals: "igual a",
		ratingTermTitle: "Nota, en escala 1–5",
		ratingTermBody:
			"Cada fuente puntúa en su propia escala, así que la nota se normaliza primero: 82/100 pasa a 4.1.",
		scaleTermTitle: "Por qué × 20",
		scaleTermBody:
			"Deja el resultado como un número de 0 a 100: un juego de cinco estrellas que terminas en una hora queda en 100.",
		figureLabel: "Misma nota, distinto tiempo",
		figureTitle: "Una gran aventura, o un juego corto cada fin de semana",
		scoreLabel: `Nota ${score} de 5`,
		oneGame: "Un juego",
		weekendLabel: (weekend: string) =>
			`Un juego corto el ${weekend} fin de semana`,
		weekends: ["primer", "segundo", "tercer", "cuarto"],
		examples: [
			{
				when: "Para las vacaciones",
				label: "Una gran aventura",
				blocks: 1,
				ratio: ratioOf(80),
				ratioNote: "Bajo, porque dura mucho."
			},
			{
				when: "Para tus fines de semana",
				label: "Un juego corto cada uno",
				blocks: 4,
				ratio: ratioOf(12),
				ratioNote: "Alto, porque se terminan pronto."
			}
		],
		closingStrong: "Los dos son grandes juegos.",
		closingText:
			"La aventura tiene un Ratio más bajo solo porque dura más, no porque sea peor. Completr te ayuda a elegir el que mejor encaja en el tiempo que tienes ahora.",
		stepLabel: (number: number) => `Paso ${number}`,
		steps: [
			{
				icon: "add_circle",
				title: "Agrega un juego",
				description:
					"Búscalo en el catálogo y elige la plataforma. La nota y la duración vienen de Metacritic, RAWG y HowLongToBeat."
			},
			{
				icon: "speed",
				title: "Mira el Ratio",
				description:
					"Completr cruza qué tan bueno es cada juego con lo que toma terminarlo y te señala los buenos que se terminan pronto."
			},
			{
				icon: "sports_esports",
				title: "Decide qué jugar",
				description:
					"Ordena por Ratio y da con esa joya corta y bien valorada que encaja con el rato que tienes hoy."
			}
		]
	},
	en: {
		eyebrow: "The Ratio",
		titleStart: "What fits in",
		titleHighlight: "your time",
		introStart: "The",
		introAnswer: "answers the question you ask every night:",
		introQuestion: "what should I play now?",
		introPoints: "It doesn't say which game is better: it points you to",
		introHighlight: "the good ones that are quick to finish",
		introEnd: ", so you can pick based on the time you have.",
		afterFinish:
			"And when you finish a game, it tells you whether it paid off more or less than you expected.",
		formulaRating: "Rating",
		formulaHours: "Hours",
		dividedBy: "divided by",
		times: "times",
		equals: "equals",
		ratingTermTitle: "Rating, on a 1–5 scale",
		ratingTermBody:
			"Each source scores on its own scale, so the rating is normalized first: 82/100 becomes 4.1.",
		scaleTermTitle: "Why × 20",
		scaleTermBody:
			"It turns the result into a number from 0 to 100: a five-star game you finish in one hour lands at 100.",
		figureLabel: "Same rating, different time",
		figureTitle: "One big adventure, or a short game every weekend",
		scoreLabel: `Rating ${score} out of 5`,
		oneGame: "One game",
		weekendLabel: (weekend: string) =>
			`A short game on the ${weekend} weekend`,
		weekends: ["first", "second", "third", "fourth"],
		examples: [
			{
				when: "For the holidays",
				label: "One big adventure",
				blocks: 1,
				ratio: ratioOf(80),
				ratioNote: "Low, because it's long."
			},
			{
				when: "For your weekends",
				label: "A short game each",
				blocks: 4,
				ratio: ratioOf(12),
				ratioNote: "High, because they're quick to finish."
			}
		],
		closingStrong: "Both are great games.",
		closingText:
			"The adventure has a lower Ratio only because it takes longer, not because it's worse. Completr helps you pick the one that best fits the time you have right now.",
		stepLabel: (number: number) => `Step ${number}`,
		steps: [
			{
				icon: "add_circle",
				title: "Add a game",
				description:
					"Find it in the catalog and pick the platform. The rating and length come from Metacritic, RAWG and HowLongToBeat."
			},
			{
				icon: "speed",
				title: "Check the Ratio",
				description:
					"Completr weighs how good each game is against how long it takes to finish and points out the good ones that wrap up quickly."
			},
			{
				icon: "sports_esports",
				title: "Decide what to play",
				description:
					"Sort by Ratio and find that short, well-rated gem that fits the time you have today."
			}
		]
	}
} satisfies Record<Locale, unknown>;

const t = copy[lang];
---

<section
	id="ratio"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute top-1/3 -left-40 w-[500px] h-[500px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div class="relative max-w-6xl mx-auto">
		<div
			class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 lg:items-stretch"
		>
			<div>
				<span class="eyebrow">{t.eyebrow}</span>
				<h2
					class="font-display mt-3 mb-5 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
				>
					{t.titleStart}{" "}
					<span class="text-gradient">{t.titleHighlight}</span>.
				</h2>
				<p
					class="m-0 mb-4 text-[var(--color-fg-secondary)] leading-relaxed"
				>
					{t.introStart}{" "}
					<strong class="text-[var(--color-fg)]">Ratio</strong>{" "}
					{t.introAnswer}{" "}
					<em>{t.introQuestion}</em>{" "}
					{t.introPoints}{" "}
					<strong class="text-[var(--color-fg)]"
						>{t.introHighlight}</strong
					>{t.introEnd}
				</p>
				<p
					class="m-0 mb-6 text-[var(--color-fg-secondary)] leading-relaxed"
				>
					{t.afterFinish}
				</p>

				<div
					class="p-5 sm:p-6 rounded-2xl border border-[var(--color-brand)]/30 bg-[var(--color-brand)]/10"
				>
					<div>
						<p
							class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-display text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-fg)]"
						>
							<span
								>{t.formulaRating}{" "}
								<span
									class="font-sans text-xs sm:text-sm font-medium tracking-normal text-[var(--color-fg-muted)] tabular-nums"
									>(1–5)</span
								></span
							>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">÷</span
							>
							<span class="sr-only">{t.dividedBy}</span>
							<span>{t.formulaHours}</span>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">×</span
							>
							<span class="sr-only">{t.times}</span>
							<span class="tabular-nums">{ratioScale}</span>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">=</span
							>
							<span class="sr-only">{t.equals}</span>
							<span class="text-[var(--color-brand)]">Ratio</span>
						</p>
						<dl
							class="m-0 mt-5 grid gap-4 sm:grid-cols-2 text-sm leading-relaxed"
						>
							<div>
								<dt
									class="font-semibold text-[var(--color-fg)]"
								>
									{t.ratingTermTitle}
								</dt>
								<dd
									class="m-0 mt-1 text-[var(--color-fg-secondary)]"
								>
									{t.ratingTermBody}
								</dd>
							</div>
							<div>
								<dt
									class="font-semibold text-[var(--color-fg)]"
								>
									{t.scaleTermTitle}
								</dt>
								<dd
									class="m-0 mt-1 text-[var(--color-fg-secondary)]"
								>
									{t.scaleTermBody}
								</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>

			<figure
				class="m-0 flex flex-col rounded-2xl p-6 sm:p-8 bg-[var(--color-surface)] border border-[var(--color-line)]"
				style="box-shadow: 0 30px 60px -30px var(--color-brand-glow);"
			>
				<figcaption class="mb-7">
					<span
						class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-muted)]"
						>{t.figureLabel}</span
					>
					<span
						class="block mt-1 font-display text-xl font-bold text-[var(--color-fg)] text-balance"
						>{t.figureTitle}</span
					>
				</figcaption>

				<div class="mb-7 flex flex-col gap-7">
					{
						t.examples.map(example => (
							<div>
								<div class="mb-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
									<p class="m-0 text-sm font-semibold text-[var(--color-fg)]">
										{example.when}
									</p>
									<span
										class="inline-flex text-[var(--color-brand)]"
										role="img"
										aria-label={t.scoreLabel}
									>
										{stars.map(icon => (
											<span
												class="material-icons text-base"
												aria-hidden="true"
											>
												{icon}
											</span>
										))}
									</span>
								</div>
								{example.blocks === 1 ? (
									<div
										class="flex h-14 items-center gap-2 rounded-xl px-4 text-sm font-semibold text-white"
										style={blockBackground}
									>
										<span
											class="material-icons text-xl"
											aria-hidden="true"
										>
											explore
										</span>
										{example.label}
									</div>
								) : (
									<ul class="m-0 grid h-14 list-none grid-cols-4 gap-2 p-0">
										{t.weekends.map(weekend => (
											<li
												class="flex items-center justify-center gap-1.5 rounded-xl text-xs font-semibold text-white"
												style={blockBackground}
											>
												<span
													class="material-icons text-lg"
													aria-hidden="true"
												>
													sports_esports
												</span>
												<span
													class="max-sm:hidden"
													aria-hidden="true"
												>
													{t.oneGame}
												</span>
												<span class="sr-only">
													{t.weekendLabel(weekend)}
												</span>
											</li>
										))}
									</ul>
								)}
								<p class="m-0 mt-2.5 flex items-center gap-2 text-sm text-[var(--color-fg-secondary)]">
									<span class="shrink-0 rounded-full border border-[var(--color-line-strong)] px-2.5 py-0.5 text-xs font-semibold text-[var(--color-fg)] tabular-nums">
										Ratio {example.ratio}
									</span>
									{example.ratioNote}
								</p>
							</div>
						))
					}
				</div>

				<p
					class="m-0 mt-auto pt-5 border-t border-[var(--color-line)] text-sm text-[var(--color-fg-secondary)] leading-relaxed"
				>
					<strong class="text-[var(--color-fg)]"
						>{t.closingStrong}</strong
					>{" "}
					{t.closingText}
				</p>
			</figure>
		</div>

		<ol
			class="m-0 mt-20 p-0 list-none grid grid-cols-1 md:grid-cols-3 gap-4"
		>
			{
				t.steps.map((step, index) => (
					<li class="relative flex gap-4 p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)]">
						<span
							class="flex items-center justify-center w-11 h-11 shrink-0 rounded-xl bg-[var(--color-brand)]/15 text-[var(--color-brand)]"
							aria-hidden="true"
						>
							<span class="material-icons text-[1.375rem]">
								{step.icon}
							</span>
						</span>
						<div>
							<span class="block text-xs font-semibold text-[var(--color-fg-muted)]">
								{t.stepLabel(index + 1)}
							</span>
							<h3 class="font-display m-0 mt-0.5 mb-1.5 text-lg font-bold text-[var(--color-fg)]">
								{step.title}
							</h3>
							<p class="m-0 text-sm text-[var(--color-fg-secondary)] leading-relaxed">
								{step.description}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
