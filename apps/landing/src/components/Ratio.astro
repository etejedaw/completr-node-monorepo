---
const ratioScale = 20;
const score = 4.75;
const stars = ["star", "star", "star", "star", "star_half"];
const weekends = ["primer", "segundo", "tercer", "cuarto"];
const blockBackground =
	"background: linear-gradient(90deg, var(--color-brand-deep), var(--color-brand));";
const ratioOf = (hours: number) =>
	(Math.round((score / hours) * ratioScale * 10) / 10).toFixed(1);
const examples = [
	{
		when: "Para las vacaciones",
		label: "Una gran aventura",
		blocks: 1,
		ratio: ratioOf(80),
		ratioNote: "Bajo, porque dura mucho."
	},
	{
		when: "Para tus fines de semana",
		label: "Un juego corto cada uno",
		blocks: 4,
		ratio: ratioOf(12),
		ratioNote: "Alto, porque se terminan pronto."
	}
];

const steps = [
	{
		icon: "add_circle",
		title: "Agrega un juego",
		description:
			"Búscalo en el catálogo y elige la plataforma. La nota y la duración vienen de Metacritic, RAWG y HowLongToBeat."
	},
	{
		icon: "speed",
		title: "Mira el Ratio",
		description:
			"Completr cruza qué tan bueno es cada juego con lo que toma terminarlo y te señala los buenos que se terminan pronto."
	},
	{
		icon: "sports_esports",
		title: "Decide qué jugar",
		description:
			"Ordena por Ratio y encuentra esa joya corta y bien valorada que llevas meses postergando."
	}
];
---

<section
	id="ratio"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute top-1/3 -left-40 w-[500px] h-[500px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div class="relative max-w-6xl mx-auto">
		<div
			class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 lg:items-stretch"
		>
			<div>
				<span class="eyebrow">El Ratio</span>
				<h2
					class="font-display mt-3 mb-5 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
				>
					Lo que cabe en <span class="text-gradient">tu tiempo</span>.
				</h2>
				<p
					class="m-0 mb-4 text-[var(--color-fg-secondary)] leading-relaxed"
				>
					El <strong class="text-[var(--color-fg)]">Ratio</strong>{
						" "
					}
					responde la pregunta de cada noche:{" "}
					<em>¿qué juego ahora?</em> No dice qué juego es mejor: te señala{
						" "
					}
					<strong class="text-[var(--color-fg)]"
						>los buenos que se terminan pronto</strong
					>, para que elijas según el tiempo que tengas.
				</p>
				<p
					class="m-0 mb-6 text-[var(--color-fg-secondary)] leading-relaxed"
				>
					Y cuando terminas un juego, te cuenta si te rindió más o
					menos de lo que esperabas.
				</p>

				<div
					class="p-5 sm:p-6 rounded-2xl border border-[var(--color-brand)]/30 bg-[var(--color-brand)]/10"
				>
					<div>
						<p
							class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-display text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-fg)]"
						>
							<span
								>Nota{" "}
								<span
									class="font-sans text-xs sm:text-sm font-medium tracking-normal text-[var(--color-fg-muted)] tabular-nums"
									>(1–5)</span
								></span
							>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">÷</span
							>
							<span class="sr-only">dividido por</span>
							<span>Horas</span>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">×</span
							>
							<span class="sr-only">por</span>
							<span class="tabular-nums">{ratioScale}</span>
							<span
								aria-hidden="true"
								class="text-[var(--color-fg-muted)]">=</span
							>
							<span class="sr-only">igual a</span>
							<span class="text-[var(--color-brand)]">Ratio</span>
						</p>
						<dl
							class="m-0 mt-5 grid gap-4 sm:grid-cols-2 text-sm leading-relaxed"
						>
							<div>
								<dt
									class="font-semibold text-[var(--color-fg)]"
								>
									Nota, en escala 1–5
								</dt>
								<dd
									class="m-0 mt-1 text-[var(--color-fg-secondary)]"
								>
									Cada fuente puntúa en su propia escala, así
									que la nota se normaliza primero: 82/100
									pasa a 4.1.
								</dd>
							</div>
							<div>
								<dt
									class="font-semibold text-[var(--color-fg)]"
								>
									Por qué × 20
								</dt>
								<dd
									class="m-0 mt-1 text-[var(--color-fg-secondary)]"
								>
									Deja el resultado como un número de 0 a 100:
									un juego de cinco estrellas que terminas en
									una hora queda en 100.
								</dd>
							</div>
						</dl>
					</div>
				</div>
			</div>

			<figure
				class="m-0 flex flex-col rounded-2xl p-6 sm:p-8 bg-[var(--color-surface)] border border-[var(--color-line)]"
				style="box-shadow: 0 30px 60px -30px var(--color-brand-glow);"
			>
				<figcaption class="mb-7">
					<span
						class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-fg-muted)]"
						>Misma nota, distinto tiempo</span
					>
					<span
						class="block mt-1 font-display text-xl font-bold text-[var(--color-fg)] text-balance"
						>Una gran aventura, o un juego corto cada fin de semana</span
					>
				</figcaption>

				<div class="mb-7 flex flex-col gap-7">
					{
						examples.map(example => (
							<div>
								<div class="mb-2.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
									<p class="m-0 text-sm font-semibold text-[var(--color-fg)]">
										{example.when}
									</p>
									<span
										class="inline-flex text-[var(--color-brand)]"
										role="img"
										aria-label={`Nota ${score} de 5`}
									>
										{stars.map(icon => (
											<span
												class="material-icons text-base"
												aria-hidden="true"
											>
												{icon}
											</span>
										))}
									</span>
								</div>
								{example.blocks === 1 ? (
									<div
										class="flex h-14 items-center gap-2 rounded-xl px-4 text-sm font-semibold text-white"
										style={blockBackground}
									>
										<span
											class="material-icons text-xl"
											aria-hidden="true"
										>
											explore
										</span>
										{example.label}
									</div>
								) : (
									<ul class="m-0 grid h-14 list-none grid-cols-4 gap-2 p-0">
										{weekends.map(weekend => (
											<li
												class="flex items-center justify-center gap-1.5 rounded-xl text-xs font-semibold text-white"
												style={blockBackground}
											>
												<span
													class="material-icons text-lg"
													aria-hidden="true"
												>
													sports_esports
												</span>
												<span
													class="max-sm:hidden"
													aria-hidden="true"
												>
													Un juego
												</span>
												<span class="sr-only">
													Un juego corto el {weekend}{" "}
													fin de semana
												</span>
											</li>
										))}
									</ul>
								)}
								<p class="m-0 mt-2.5 flex items-center gap-2 text-sm text-[var(--color-fg-secondary)]">
									<span class="shrink-0 rounded-full border border-[var(--color-line-strong)] px-2.5 py-0.5 text-xs font-semibold text-[var(--color-fg)] tabular-nums">
										Ratio {example.ratio}
									</span>
									{example.ratioNote}
								</p>
							</div>
						))
					}
				</div>

				<p
					class="m-0 mt-auto pt-5 border-t border-[var(--color-line)] text-sm text-[var(--color-fg-secondary)] leading-relaxed"
				>
					<strong class="text-[var(--color-fg)]"
						>Los dos son grandes juegos.</strong
					>{" "}
					La aventura tiene un Ratio más bajo solo porque dura más, no porque
					sea peor. Completr te ayuda a elegir el que mejor encaja en el
					tiempo que tienes ahora.
				</p>
			</figure>
		</div>

		<ol
			class="m-0 mt-20 p-0 list-none grid grid-cols-1 md:grid-cols-3 gap-4"
		>
			{
				steps.map((step, index) => (
					<li class="relative flex gap-4 p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)]">
						<span
							class="flex items-center justify-center w-11 h-11 shrink-0 rounded-xl bg-[var(--color-brand)]/15 text-[var(--color-brand)]"
							aria-hidden="true"
						>
							<span class="material-icons text-[1.375rem]">
								{step.icon}
							</span>
						</span>
						<div>
							<span class="block text-xs font-semibold text-[var(--color-fg-muted)]">
								Paso {index + 1}
							</span>
							<h3 class="font-display m-0 mt-0.5 mb-1.5 text-lg font-bold text-[var(--color-fg)]">
								{step.title}
							</h3>
							<p class="m-0 text-sm text-[var(--color-fg-secondary)] leading-relaxed">
								{step.description}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
