---
import { getCollection } from "astro:content";

const all = await getCollection("releases");

const sorted = all.sort((a, b) => {
	if (a.data.date !== b.data.date) return a.data.date < b.data.date ? 1 : -1;
	return b.data.order - a.data.order;
});

const recent = sorted.slice(0, 5);
const totalReleases = sorted.length;

const firstDate = sorted[sorted.length - 1]?.data.date;
const lastDate = sorted[0]?.data.date;

function weeksBetween(startIso: string, endIso: string): number {
	if (!startIso || !endIso) return 0;
	const start = Date.UTC(
		...(startIso.split("-").map(Number) as [number, number, number])
	);
	const end = Date.UTC(
		...(endIso.split("-").map(Number) as [number, number, number])
	);
	return Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24 * 7)));
}

function daysSince(iso: string): number {
	if (!iso) return 0;
	const [y, m, d] = iso.split("-").map(Number);
	const target = Date.UTC(y, m - 1, d);
	const now = Date.now();
	return Math.max(0, Math.floor((now - target) / (1000 * 60 * 60 * 24)));
}

const spanWeeks = weeksBetween(firstDate, lastDate);
const daysSinceLast = daysSince(lastDate);

function formatDate(iso: string): string {
	const [year, month, day] = iso.split("-").map(Number);
	const date = new Date(Date.UTC(year, month - 1, day));
	return new Intl.DateTimeFormat("es", {
		day: "numeric",
		month: "short",
		timeZone: "UTC"
	}).format(date);
}

function tintBg(tint: string): string {
	switch (tint) {
		case "brand":
			return "background: rgba(139, 92, 246, 0.15); color: var(--color-brand);";
		case "purple":
			return "background: rgba(168, 85, 247, 0.15); color: #a855f7;";
		case "warning":
			return "background: rgba(249, 115, 22, 0.15); color: #f97316;";
		case "success":
			return "background: rgba(34, 197, 94, 0.15); color: #22c55e;";
		case "danger":
			return "background: rgba(239, 68, 68, 0.15); color: #ef4444;";
		default:
			return "background: var(--color-surface); color: var(--color-fg-secondary);";
	}
}

const lastReleaseStat =
	daysSinceLast === 0
		? { value: "Hoy", label: "último release" }
		: {
				value: String(daysSinceLast),
				label:
					daysSinceLast === 1
						? "día desde el último"
						: "días desde el último"
			};

const stats = [
	{ value: String(totalReleases), label: "releases" },
	{ value: String(spanWeeks), label: "semanas de desarrollo" },
	lastReleaseStat
];
---

<section
	id="changelog"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute inset-0 pointer-events-none"
		style="background: radial-gradient(ellipse 60% 40% at 15% 0%, rgba(139, 92, 246, 0.12), transparent 70%);"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative max-w-6xl mx-auto grid gap-12 lg:grid-cols-12 lg:gap-16"
	>
		<div class="min-w-0 lg:col-span-5 lg:sticky lg:top-28 self-start">
			<span
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[var(--color-brand)]/30 bg-[var(--color-brand)]/10 text-xs font-semibold uppercase tracking-[0.15em] text-[var(--color-brand)]"
			>
				<span class="relative flex h-2 w-2" aria-hidden="true">
					<span
						class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 bg-[var(--color-brand)]"
					></span>
					<span
						class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-brand)]"
					></span>
				</span>
				En desarrollo activo
			</span>
			<h2
				class="font-display mt-4 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
			>
				El cambio es <span class="text-gradient">constante</span>.
			</h2>
			<p class="m-0 text-[var(--color-fg-secondary)] leading-relaxed">
				Cada semana entran funciones pedidas por los testers, ajustes de
				UX y mejoras de rendimiento.
			</p>

			<dl
				class="m-0 mt-8 grid grid-cols-3 gap-px rounded-2xl overflow-hidden bg-[var(--color-line)] border border-[var(--color-line)]"
			>
				{
					stats.map(stat => (
						<div class="flex flex-col-reverse justify-end gap-1 p-4 bg-[var(--color-surface)]">
							<dt class="text-xs leading-snug text-[var(--color-fg-muted)]">
								{stat.label}
							</dt>
							<dd class="m-0 font-display text-3xl font-bold tracking-tight text-gradient tabular-nums">
								{stat.value}
							</dd>
						</div>
					))
				}
			</dl>

			<a href="/changelog" class="btn-primary mt-8">
				Ver las {totalReleases} novedades
				<span class="material-icons text-[1.125rem]" aria-hidden="true"
					>arrow_forward</span
				>
			</a>
		</div>

		<ol
			class="min-w-0 lg:col-span-7 m-0 p-0 list-none relative before:absolute before:left-[1.375rem] before:top-6 before:bottom-6 before:w-px before:bg-[var(--color-line-strong)]"
		>
			{
				recent.map((entry, index) => (
					<li class="relative flex gap-5 pb-8 last:pb-0">
						<span
							class="relative z-10 flex items-center justify-center w-11 h-11 rounded-xl shrink-0 ring-4 ring-[var(--color-canvas)]"
							style={tintBg(entry.data.tint)}
							aria-hidden="true"
						>
							<span class="material-icons text-[1.375rem]">
								{entry.data.icon}
							</span>
						</span>
						<article
							class="flex-1 min-w-0 rounded-2xl p-5 border"
							class:list={[
								index === 0
									? "border-[var(--color-brand)]/40 bg-[var(--color-surface)]"
									: "border-[var(--color-line)] bg-[var(--color-surface)]/60"
							]}
							style={
								index === 0
									? "box-shadow: 0 24px 48px -28px var(--color-brand-glow);"
									: undefined
							}
						>
							<div class="flex items-center gap-2 mb-2 flex-wrap">
								{index === 0 && (
									<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[0.625rem] font-bold uppercase tracking-wider bg-[var(--color-brand)] text-white">
										Último release
									</span>
								)}
								<span
									class="inline-block px-2 py-0.5 rounded-full text-[0.625rem] font-bold uppercase tracking-wider"
									style={tintBg(entry.data.tint)}
								>
									{entry.data.tag}
								</span>
								<time
									datetime={entry.data.date}
									class="text-xs text-[var(--color-fg-muted)]"
								>
									{formatDate(entry.data.date)}
								</time>
							</div>
							<h3
								class="font-display m-0 font-bold text-[var(--color-fg)] leading-tight"
								class:list={[
									index === 0
										? "text-xl mb-2"
										: "text-base mb-1.5"
								]}
							>
								{entry.data.title}
							</h3>
							{entry.data.landing?.pitch && (
								<p
									class="m-0 text-sm text-[var(--color-fg-secondary)] leading-relaxed"
									class:list={[index !== 0 && "line-clamp-2"]}
								>
									{entry.data.landing.pitch}
								</p>
							)}
						</article>
					</li>
				))
			}
		</ol>
	</div>
</section>
