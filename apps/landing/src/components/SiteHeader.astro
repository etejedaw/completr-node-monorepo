---
import { getRelativeLocaleUrl } from "astro:i18n";

import {
	type Locale,
	localeNames,
	locales,
	pathWithoutLocale,
	toLocale
} from "../i18n/locales";

const lang = toLocale(Astro.currentLocale);
const path = pathWithoutLocale(Astro.url.pathname, lang);
const homeUrl = getRelativeLocaleUrl(lang);

const copy = {
	es: {
		navLabel: "Principal",
		links: [
			{ section: "#ratio", label: "El Ratio" },
			{ section: "#rewind", label: "Rewind" },
			{ section: "#tour", label: "La app" },
			{ section: "#open-source", label: "Código" },
			{ section: "#changelog", label: "Novedades" }
		],
		cta: "Pedir invitación",
		ctaShort: "Pedir acceso"
	},
	en: {
		navLabel: "Main",
		links: [
			{ section: "#ratio", label: "The Ratio" },
			{ section: "#rewind", label: "Rewind" },
			{ section: "#tour", label: "The app" },
			{ section: "#open-source", label: "Code" },
			{ section: "#changelog", label: "What's new" }
		],
		cta: "Request an invite",
		ctaShort: "Get an invite"
	}
} satisfies Record<Locale, unknown>;

const t = copy[lang];
const languageLinks = locales
	.filter(locale => locale !== lang)
	.map(locale => ({
		locale,
		href: getRelativeLocaleUrl(locale, path),
		label: localeNames[locale]
	}));
---

<header
	class="sticky top-0 z-50 border-b border-[var(--color-line)]/70 bg-[var(--color-canvas)]/80 backdrop-blur-md"
>
	<nav
		aria-label={t.navLabel}
		class="max-w-6xl mx-auto flex items-center gap-3 sm:gap-6 h-16 px-6"
	>
		<a
			href={homeUrl}
			class="flex items-center gap-2.5 min-h-[44px] no-underline text-[var(--color-fg)]"
		>
			<span
				class="flex items-center justify-center w-8 h-8 rounded-lg font-display font-extrabold text-sm text-white"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 6px 16px -4px var(--color-brand-glow);"
				aria-hidden="true">C</span
			>
			<span class="font-display text-lg font-bold tracking-tight"
				>Completr</span
			>
		</a>

		<ul class="hidden md:flex items-center gap-1 m-0 p-0 list-none">
			{
				t.links.map(link => (
					<li>
						<a
							href={`${homeUrl}${link.section}`}
							class="inline-flex items-center min-h-[44px] px-3 text-sm font-medium text-[var(--color-fg-secondary)] no-underline transition-colors hover:text-[var(--color-fg)]"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="ml-auto flex items-center gap-1 sm:gap-2">
			{
				languageLinks.map(link => (
					<a
						href={link.href}
						hreflang={link.locale}
						lang={link.locale}
						aria-label={link.label}
						class="inline-flex items-center justify-center gap-1 min-w-[44px] min-h-[44px] px-2.5 rounded-xl text-sm font-semibold uppercase tracking-wide text-[var(--color-fg-secondary)] no-underline transition-colors hover:text-[var(--color-fg)] hover:bg-[var(--color-surface)]"
					>
						<span class="max-sm:hidden" aria-hidden="true">
							<span class="material-icons text-[1.125rem]">
								translate
							</span>
						</span>
						{link.locale}
					</a>
				))
			}
			<a
				href={`${homeUrl}#beta-signup`}
				class="btn-primary text-sm whitespace-nowrap"
			>
				<span class="sm:hidden">{t.ctaShort}</span>
				<span class="max-sm:hidden">{t.cta}</span>
			</a>
		</div>
	</nav>
</header>
