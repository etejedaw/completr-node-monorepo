---
const links = [
	{ href: "/changelog", label: "Novedades" },
	{ href: "/privacy", label: "Privacidad" },
	{
		href: "https://github.com/etejedaw/completr-node-monorepo",
		label: "GitHub",
		external: true
	}
];
const linkClass =
	"inline-flex items-center min-h-[44px] px-2 text-sm text-[var(--color-fg-secondary)] no-underline transition-colors hover:text-[var(--color-brand)]";
---

<footer class="relative px-6 border-t border-[var(--color-line)]">
	<div
		class="max-w-6xl mx-auto py-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-8"
	>
		<a
			href="/"
			class="flex items-center gap-2.5 min-h-[44px] self-start md:self-auto no-underline text-[var(--color-fg)]"
		>
			<span
				class="flex items-center justify-center w-7 h-7 rounded-lg font-display font-extrabold text-xs text-white"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));"
				aria-hidden="true">C</span
			>
			<span class="font-display font-bold tracking-tight">Completr</span>
		</a>

		<nav aria-label="Pie de página" class="md:ml-auto">
			<ul class="m-0 p-0 list-none flex flex-wrap -mx-2">
				{
					links.map(link => (
						<li>
							<a
								href={link.href}
								class={linkClass}
								{...(link.external && {
									target: "_blank",
									rel: "noopener noreferrer"
								})}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<p class="m-0 text-sm text-[var(--color-fg-muted)]">
			Hecho con <span class="text-[var(--color-brand)]">♥</span> por{" "}
			<a
				href="https://www.etejeda.dev"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center min-h-[44px] text-[var(--color-fg-secondary)] no-underline transition-colors hover:text-[var(--color-brand)]"
				>Esteban Tejeda</a
			>
		</p>
	</div>
</footer>
