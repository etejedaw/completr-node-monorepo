---
import backlogDesktop from "../assets/screenshots/backlog-completed-desktop.webp";
import queueMobile from "../assets/screenshots/queue-mobile.webp";
import BetaSignupForm from "./BetaSignupForm.astro";
import DeviceFrames from "./DeviceFrames.astro";

const promises = [
	{ icon: "devices", label: "Web y celular" },
	{ icon: "install_mobile", label: "Instalable como app" },
	{ icon: "code", label: "Código abierto" }
];
---

<section class="relative px-6 pt-14 pb-20 md:pt-20 lg:pb-28 overflow-hidden">
	<div
		class="absolute -top-64 left-1/2 -translate-x-1/2 w-[1100px] h-[900px] rounded-full blur-3xl opacity-25 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-0 pointer-events-none opacity-[0.07]"
		style="background-image: linear-gradient(var(--color-fg) 1px, transparent 1px), linear-gradient(90deg, var(--color-fg) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent);"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative max-w-6xl mx-auto grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10 items-center"
	>
		<div class="flex flex-col items-start gap-6">
			<span
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/30"
			>
				<span
					class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] animate-pulse"
					aria-hidden="true"></span>
				Beta cerrada
			</span>

			<h1
				class="font-display m-0 text-[2.5rem] sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.05] text-balance"
			>
				Juega lo que <span class="text-gradient">vale tu tiempo</span>.
			</h1>

			<p
				class="m-0 text-base md:text-lg text-[var(--color-fg-secondary)] leading-relaxed max-w-xl"
			>
				Tu backlog crece más rápido que tu tiempo libre. Completr cruza
				la nota de cada juego con lo que dura y te dice cuál jugar a
				continuación. Déjame tu correo y te aviso cuando abra cupos de
				la <strong class="text-[var(--color-fg)]">beta cerrada</strong>.
			</p>

			<div class="w-full max-w-xl [&_form]:mx-0 [&_p]:text-left">
				<BetaSignupForm />
			</div>

			<ul
				class="m-0 p-0 list-none flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--color-fg-muted)]"
			>
				{
					promises.map(item => (
						<li class="inline-flex items-center gap-1.5">
							<span
								class="material-icons text-[1.125rem] text-[var(--color-brand)]"
								aria-hidden="true"
							>
								{item.icon}
							</span>
							{item.label}
						</li>
					))
				}
			</ul>
		</div>

		<div class="lg:-mr-24 xl:-mr-40">
			<DeviceFrames
				desktop={backlogDesktop}
				desktopAlt="My Games: la biblioteca con el Ratio de cada juego, tu nota y tu run"
				mobile={queueMobile}
				mobileAlt="Up Next en el celular: el próximo juego a jugar y la cola ordenada"
				windowTitle="My Games · Completr"
				phoneSide="left"
				phoneInside
				eager
			/>
		</div>
	</div>
</section>
