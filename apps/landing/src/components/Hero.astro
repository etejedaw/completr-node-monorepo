---
import backlogDesktop from "../assets/screenshots/backlog-completed-desktop.webp";
import queueMobile from "../assets/screenshots/queue-mobile.webp";
import BetaSignupForm from "./BetaSignupForm.astro";
import DeviceFrames from "./DeviceFrames.astro";

const promises = [
	{ icon: "devices", label: "Web y celular" },
	{ icon: "install_mobile", label: "Instalable como app" },
	{ icon: "code", label: "Código abierto" }
];
---

<section class="relative px-6 pt-14 pb-20 md:pt-20 lg:pb-28 overflow-hidden">
	<div
		class="absolute -top-64 left-1/2 -translate-x-1/2 w-[1100px] h-[900px] rounded-full blur-3xl opacity-25 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>
	<div
		class="absolute inset-0 pointer-events-none opacity-[0.07]"
		style="background-image: linear-gradient(var(--color-fg) 1px, transparent 1px), linear-gradient(90deg, var(--color-fg) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent);"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative max-w-6xl mx-auto grid gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10 items-center"
	>
		<div class="flex flex-col items-start gap-6">
			<a
				href="#v1"
				class="hero-reveal group inline-flex items-center gap-2 min-h-[44px] pl-1.5 pr-3 rounded-full text-sm font-medium no-underline text-[var(--color-fg-secondary)] border border-[var(--color-line-strong)] bg-[var(--color-surface)]/70 transition-colors hover:border-[var(--color-brand)]/50 hover:text-[var(--color-fg)]"
			>
				<span
					class="inline-flex items-center h-7 px-2.5 rounded-full font-display font-bold text-xs tracking-wide text-white"
					style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));"
					>1.0</span
				>
				Ya salió Completr 1.0
				<span
					class="material-icons text-[1rem] transition-transform group-hover:translate-x-0.5"
					aria-hidden="true">arrow_forward</span
				>
			</a>

			<h1
				class="hero-reveal font-display m-0 text-[2.5rem] sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.05] text-balance"
			>
				Juega lo que <span class="text-gradient">vale tu tiempo</span>.
			</h1>

			<p
				class="hero-reveal m-0 text-base md:text-lg text-[var(--color-fg-secondary)] leading-relaxed max-w-xl"
			>
				Tu backlog crece más rápido que tu tiempo libre. Completr cruza
				la nota de cada juego con lo que dura y te dice cuál jugar a
				continuación. La 1.0 suma tu año en juegos, platinos y sagas.
			</p>

			<div class="hero-reveal w-full max-w-xl flex flex-col gap-3">
				<p
					class="m-0 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-fg)]"
				>
					<span
						class="material-icons text-[1.125rem] text-[var(--color-brand)]"
						aria-hidden="true">mail</span
					>
					Acceso por invitación. Pide la tuya.
				</p>
				<div class="[&_form]:mx-0 [&_p]:text-left">
					<BetaSignupForm />
				</div>
			</div>

			<ul
				class="hero-reveal m-0 p-0 list-none flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--color-fg-muted)]"
			>
				{
					promises.map(item => (
						<li class="inline-flex items-center gap-1.5">
							<span
								class="material-icons text-[1.125rem] text-[var(--color-brand)]"
								aria-hidden="true"
							>
								{item.icon}
							</span>
							{item.label}
						</li>
					))
				}
			</ul>
		</div>

		<div class="hero-reveal relative lg:mt-32 lg:-mr-24 xl:-mr-40">
			<span
				class="hero-version font-display absolute -top-16 right-2 sm:-top-24 lg:-top-44 lg:right-24 xl:right-40 font-bold leading-none select-none pointer-events-none"
				aria-hidden="true">1.0</span
			>
			<DeviceFrames
				desktop={backlogDesktop}
				desktopAlt="My Games: la biblioteca con el Ratio de cada juego, tu nota y tu run"
				mobile={queueMobile}
				mobileAlt="Up Next en el celular: el próximo juego a jugar y la cola ordenada"
				windowTitle="My Games · Completr"
				phoneSide="left"
				phoneInside
				eager
			/>
		</div>
	</div>
</section>

<style>
	.hero-version {
		font-size: clamp(7rem, 22vw, 17rem);
		letter-spacing: -0.04em;
		color: transparent;
		-webkit-text-stroke: 1.5px rgba(196, 168, 255, 0.35);
		background-image: linear-gradient(
			180deg,
			rgba(139, 92, 246, 0.22),
			transparent 75%
		);
		-webkit-background-clip: text;
		background-clip: text;
	}

	.hero-reveal {
		animation: hero-reveal 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero-reveal:nth-child(2) {
		animation-delay: 80ms;
	}

	.hero-reveal:nth-child(3) {
		animation-delay: 160ms;
	}

	.hero-reveal:nth-child(4) {
		animation-delay: 240ms;
	}

	.hero-reveal:nth-child(5) {
		animation-delay: 320ms;
	}

	@keyframes hero-reveal {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
</style>
