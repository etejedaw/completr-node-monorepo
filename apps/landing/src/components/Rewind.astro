---
import { Picture } from "astro:assets";

import rewindStoryList from "../assets/screenshots/rewind-story-list-mobile.webp";
import rewindStory from "../assets/screenshots/rewind-story-mobile.webp";

const shareImages = [
	{
		src: rewindStory,
		alt: "Primera imagen del Rewind 2026 para historias: las portadas del año, los juegos terminados, el tipo de jugador y las horas jugadas"
	},
	{
		src: rewindStoryList,
		alt: "Segunda imagen del Rewind 2026 para historias: la lista de los juegos terminados en el año, como los créditos de una película"
	}
];

const points = [
	{ icon: "ios_share", label: "Dos imágenes para tus historias" },
	{
		icon: "link",
		label: "Un enlace para compartir, aunque tu perfil sea privado"
	},
	{
		icon: "auto_awesome",
		label: "Un resumen escrito con IA, si lo pides. Tú decides si usa tus notas"
	}
];
---

<section
	id="rewind"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute -top-40 -right-40 w-[700px] h-[700px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative max-w-6xl mx-auto grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 items-center"
	>
		<div class="flex flex-col items-start gap-5">
			<span class="eyebrow">Rewind</span>
			<h2
				class="font-display m-0 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
			>
				Tu año en juegos, <span class="rewind-gradient"
					>tal como lo viviste</span
				>.
			</h2>
			<p
				class="m-0 text-[var(--color-fg-secondary)] leading-relaxed max-w-xl"
			>
				Al cerrar el año, Completr arma tu Rewind: lo que terminaste, lo
				que soltaste y lo que completaste al cien por cien. Cada
				temporada estrena diseño, y tu año queda guardado tal como
				cerró.
			</p>
			<ul
				class="m-0 p-0 list-none flex flex-col gap-3 text-[var(--color-fg-secondary)]"
			>
				{
					points.map(point => (
						<li class="flex items-start gap-3">
							<span
								class="flex items-center justify-center w-9 h-9 shrink-0 rounded-xl bg-[var(--color-brand)]/15 text-[var(--color-brand)]"
								aria-hidden="true"
							>
								<span class="material-icons text-[1.25rem]">
									{point.icon}
								</span>
							</span>
							<span class="pt-1.5 leading-relaxed">
								{point.label}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<div
			class="relative mx-auto flex items-start w-[min(24rem,100%)] lg:w-full lg:max-w-[28rem] pb-10"
		>
			{
				shareImages.map(image => (
					<div
						class="rewind-card relative w-[58%] shrink-0 rounded-[1.25rem] overflow-hidden border border-white/10"
						style="box-shadow: 0 40px 80px -30px rgba(0,0,0,0.95), 0 0 60px -20px var(--color-brand-glow);"
					>
						<Picture
							src={image.src}
							alt={image.alt}
							formats={["avif", "webp"]}
							fallbackFormat="webp"
							widths={[240, 360, 480, 720]}
							sizes="(min-width: 1024px) 260px, 56vw"
							class="block w-full h-auto"
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.rewind-gradient {
		background-image: linear-gradient(90deg, #a78bfa, #f472b6, #fb923c);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.rewind-card {
		transition: transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.rewind-card:first-child {
		transform: rotate(-4deg);
	}

	.rewind-card:last-child {
		z-index: 1;
		margin-top: 2.5rem;
		margin-left: -16%;
		transform: rotate(4deg);
	}

	.rewind-card:hover {
		z-index: 2;
		transform: rotate(0deg) translateY(-4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.rewind-card {
			transition: none;
		}
	}
</style>
