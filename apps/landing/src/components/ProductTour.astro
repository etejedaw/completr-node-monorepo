	en: {
		eyebrow: "Inside the app",
		titleStart: "Your whole backlog,",
		titleHighlight: "in one place",
		lead: "Real Completr screenshots, on desktop and on mobile.",
		libraryEyebrow: "My Games",
		libraryTitle: "Your library, the way you want to see it.",
		libraryBody:
			"Every game with its status, your rating, your real hours and the Ratio in plain sight. Switch views depending on what you need.",
		viewsLabel: "My Games view",
		libraryMobileAlt: "My Games on a phone",
		libraryPoints: [
			"Filters, saved views and mood tags",
			"Surprise me picks for you among your filters",
			"Co-op runs with your friends"
		],
		libraryViews: [
			{
				id: "diary",
