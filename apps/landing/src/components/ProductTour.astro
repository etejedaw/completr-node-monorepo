				windowTitle: "Resident Evil 4 · Completr"
			},
			{
				id: "lists",
				eyebrow: "Lists and sagas",
				title: "Follow every saga at your own pace.",
				body: "Follow curated lists or build your own and see your progress game by game. Discover the sagas in the catalog and follow the ones you care about.",
				points: [
					"Your progress in every list",
					"Compare your progress with a friend's",
					"Duplicate a public list to make it yours"
				],
				desktop: listDetailDesktop,
				desktopAlt:
					"Resident Evil saga list with the progress and Ratio of each entry",
				mobile: listDetailMobile,
				mobileAlt: "Resident Evil list on a phone with your progress",
				windowTitle: "Resident Evil · Completr"
			},
			{
				id: "profile",
				eyebrow: "Profile and friends",
				title: "Your profile, your showcase.",
				body: "Your favorites, what you're playing, your reviews and your numbers. Follow your friends and see what they finish in the feed.",
				points: [
					"Top favorites and a summary of your library",
					"A feed with the activity of the people you follow",
					"Privacy per section: you decide what's visible"
				],
				desktop: profileDesktop,
				desktopAlt:
					"Public profile with favorites, stats and a library summary",
				mobile: feedMobile,
