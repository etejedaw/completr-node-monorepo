---
import type { Release } from "../utils/releases";

interface Props {
	release: Release;
}

const { release } = Astro.props;
const { date, tint, icon, tag, title, landing } = release.data;

function formatDate(iso: string): string {
	const [year, month, day] = iso.split("-").map(Number);
	const value = new Date(Date.UTC(year, month - 1, day));
	return new Intl.DateTimeFormat("es", {
		day: "numeric",
		month: "long",
		year: "numeric",
		timeZone: "UTC"
	}).format(value);
}

function tintBg(tone: string): string {
	switch (tone) {
		case "brand":
			return "background: rgba(139, 92, 246, 0.15); color: var(--color-brand);";
		case "purple":
			return "background: rgba(168, 85, 247, 0.15); color: #a855f7;";
		case "warning":
			return "background: rgba(245, 158, 11, 0.15); color: #f59e0b;";
		case "success":
			return "background: rgba(34, 197, 94, 0.15); color: #22c55e;";
		case "danger":
			return "background: rgba(239, 68, 68, 0.15); color: #ef4444;";
		default:
			return "background: var(--color-surface); color: var(--color-fg-secondary);";
	}
}
---

<article
	id={release.id}
	data-release
	tabindex="-1"
	class="scroll-mt-24 bg-[var(--color-surface)] border border-[var(--color-line)] rounded-2xl p-5 flex items-start gap-4"
>
	<span
		class="flex items-center justify-center w-10 h-10 rounded-xl shrink-0"
		style={tintBg(tint)}
	>
		<span class="material-icons text-[1.25rem]" aria-hidden="true">
			{icon}
		</span>
	</span>
	<div class="flex-1 min-w-0">
		<div class="flex items-center gap-2 mb-1.5 flex-wrap">
			<span
				class="inline-block px-2 py-0.5 rounded-full text-[0.625rem] font-bold uppercase tracking-wider"
				style={tintBg(tint)}
			>
				{tag}
			</span>
			<time
				datetime={date}
				class="text-[0.6875rem] text-[var(--color-fg-muted)]"
			>
				{formatDate(date)}
			</time>
		</div>
		<h2
			class="font-[var(--font-display)] m-0 mb-2 text-base font-semibold text-[var(--color-fg)] leading-tight"
		>
			{title}
		</h2>
		{
			landing?.pitch && (
				<p class="m-0 text-[0.875rem] text-[var(--color-fg-secondary)] leading-relaxed">
					{landing.pitch}
				</p>
			)
		}
	</div>
</article>
