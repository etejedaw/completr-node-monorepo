---
import BetaSignupForm from "./BetaSignupForm.astro";
---

<section
	id="beta-signup"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div class="relative max-w-xl mx-auto text-center">
		<span
			class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand)]"
			>Beta cerrada</span
		>
		<h2
			class="font-[var(--font-display)] mt-3 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight"
		>
			Sé de los
			<span
				class="bg-clip-text text-transparent"
				style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
				>primeros</span
			> en probarlo.
		</h2>
		<p class="m-0 mb-8 text-[var(--color-fg-secondary)] leading-relaxed">
			Déjame tu correo y te aviso en cuanto abramos cupos. Sin spam, sin
			newsletter encubierto: solo el aviso de acceso.
		</p>

		<BetaSignupForm />
	</div>
</section>
