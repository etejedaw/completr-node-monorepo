---
import { type Locale, toLocale } from "../i18n/locales";
import BetaSignupForm from "./BetaSignupForm.astro";

const lang = toLocale(Astro.currentLocale);

const copy = {
	es: {
		eyebrow: "Sobre el proyecto",
		titleStart: "Empezó como",
		titleHighlight: "un Excel",
		story: "Ahí anotaba mis juegos para no perder el hilo. Con el tiempo se volvió una app que armé solo para mí. Con la 1.0 la abro de a poco, por invitación, para crecer sin perder el cuidado.",
		storyEnd:
			"Sin promesas grandes ni roadmap inflado. Es el tracker que me hubiera gustado tener.",
		creatorRole: "Creador de Completr",
		catalogBackedBy: "Catálogo respaldado por",
		badge: "Acceso por invitación",
		inviteStart: "Pide tu",
		inviteHighlight: "invitación",
		inviteText:
			"Te escribo con tu invitación. Sin spam ni newsletter: solo ese aviso."
	},
	en: {
		eyebrow: "About the project",
		titleStart: "It started as",
		titleHighlight: "a spreadsheet",
		story: "That's where I kept track of my games so I wouldn't lose the thread. Over time it became an app I built just for myself. With 1.0 I'm opening it up little by little, by invitation, so it can grow without losing the care.",
		storyEnd:
			"No big promises or inflated roadmap. It's the tracker I wish I'd had.",
		creatorRole: "Creator of Completr",
		catalogBackedBy: "Catalog powered by",
		badge: "Invite-only access",
		inviteStart: "Request your",
		inviteHighlight: "invitation",
		inviteText:
			"I'll write to you with your invitation. No spam, no newsletter: just that one message."
	}
} satisfies Record<Locale, unknown>;

const t = copy[lang];
---

<section
	id="beta-signup"
	class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
>
	<div
		class="absolute top-1/2 right-0 translate-x-1/3 -translate-y-1/2 w-[700px] h-[700px] rounded-full blur-3xl opacity-20 pointer-events-none"
		style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
		aria-hidden="true"
	>
	</div>

	<div
		class="relative max-w-6xl mx-auto grid gap-12 lg:grid-cols-2 lg:gap-16 items-center"
	>
		<div>
			<span class="eyebrow">{t.eyebrow}</span>
			<h2
				class="font-display mt-3 mb-5 text-3xl md:text-5xl font-bold tracking-tight leading-tight text-balance"
			>
				{t.titleStart}{" "}
				<span class="text-gradient">{t.titleHighlight}</span>.
			</h2>
			<div
				class="flex flex-col gap-4 text-[var(--color-fg-secondary)] leading-relaxed"
			>
				<p class="m-0">{t.story}</p>
				<p class="m-0">{t.storyEnd}</p>
			</div>
			<div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
				<a
					href="https://www.etejeda.dev"
					target="_blank"
					rel="noopener noreferrer"
					class="group flex items-center gap-3 min-h-[44px] no-underline"
				>
					<span
						class="flex items-center justify-center w-10 h-10 rounded-full font-display font-bold text-white"
						style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));"
						aria-hidden="true">E</span
					>
					<span class="flex flex-col text-sm leading-tight">
						<strong
							class="inline-flex items-center gap-1 text-[var(--color-fg)] transition-colors group-hover:text-[var(--color-brand)]"
							>Esteban Tejeda<span
								class="material-icons text-[0.875rem]"
								aria-hidden="true">north_east</span
							></strong
						>
						<span class="text-[var(--color-fg-muted)]"
							>{t.creatorRole}</span
						>
					</span>
				</a>
				<p
					class="m-0 inline-flex items-center gap-1 pl-4 pr-2 min-h-[44px] rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] text-xs text-[var(--color-fg-muted)]"
				>
					{t.catalogBackedBy}{" "}
					<a
						href="https://rawg.io"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center min-h-[44px] px-2 font-semibold text-[var(--color-fg-secondary)] hover:text-[var(--color-brand)] transition-colors no-underline"
						>RAWG</a
					>
				</p>
			</div>
		</div>

		<div
			class="rounded-3xl p-6 sm:p-10 border border-[var(--color-brand)]/30"
			style="background: linear-gradient(160deg, color-mix(in srgb, var(--color-brand) 16%, transparent), transparent 60%), var(--color-surface); box-shadow: 0 40px 80px -40px var(--color-brand-glow);"
		>
			<span
				class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/30"
			>
				<span
					class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] animate-pulse"
					aria-hidden="true"></span>
				{t.badge}
			</span>
			<h2
				class="font-display mt-4 mb-3 text-2xl md:text-4xl font-bold tracking-tight leading-tight text-balance"
			>
				{t.inviteStart}{" "}
				<span class="text-gradient">{t.inviteHighlight}</span>.
			</h2>
			<p
				class="m-0 mb-8 text-[var(--color-fg-secondary)] leading-relaxed"
			>
				{t.inviteText}
			</p>
			<div class="[&_form]:mx-0 [&_p]:text-left">
				<BetaSignupForm />
			</div>
		</div>
	</div>
</section>
