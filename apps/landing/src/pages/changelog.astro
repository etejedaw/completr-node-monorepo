---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const all = await getCollection("releases");

const releases = all.sort((a, b) => {
	if (a.data.date !== b.data.date) return a.data.date < b.data.date ? 1 : -1;
	return b.data.order - a.data.order;
});

function formatDate(iso: string): string {
	const [year, month, day] = iso.split("-").map(Number);
	const date = new Date(Date.UTC(year, month - 1, day));
	return new Intl.DateTimeFormat("es", {
		day: "numeric",
		month: "long",
		year: "numeric",
		timeZone: "UTC"
	}).format(date);
}

function tintBg(tint: string): string {
	switch (tint) {
		case "brand":
			return "background: rgba(139, 92, 246, 0.15); color: var(--color-brand);";
		case "purple":
			return "background: rgba(168, 85, 247, 0.15); color: #a855f7;";
		case "warning":
			return "background: rgba(245, 158, 11, 0.15); color: #f59e0b;";
		case "success":
			return "background: rgba(34, 197, 94, 0.15); color: #22c55e;";
		case "danger":
			return "background: rgba(239, 68, 68, 0.15); color: #ef4444;";
		default:
			return "background: var(--color-surface); color: var(--color-fg-secondary);";
	}
}
---

<Layout
	title="Novedades — Completr"
	description="Todas las mejoras y funcionalidades que llegaron a Completr."
>
	<main class="relative px-6 py-24 max-w-3xl mx-auto">
		<a
			href="/"
			class="inline-flex items-center gap-2 text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors no-underline mb-10"
		>
			← Volver al inicio
		</a>

		<div class="flex items-start gap-4 mb-10">
			<span
				class="flex items-center justify-center w-12 h-12 rounded-2xl text-white shrink-0"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 10px 24px -8px var(--color-brand-glow);"
			>
				<span class="material-icons text-[1.5rem]">campaign</span>
			</span>
			<div>
				<h1
					class="font-[var(--font-display)] m-0 text-3xl md:text-4xl font-bold tracking-tight"
				>
					Novedades
				</h1>
				<p
					class="text-[var(--color-fg-muted)] mt-2 text-sm leading-snug"
				>
					Todas las mejoras y funcionalidades que llegaron a Completr,
					desde el primer commit hasta el último release.
				</p>
			</div>
		</div>

		<div class="flex flex-col gap-4">
			{
				releases.map(entry => (
					<article class="bg-[var(--color-surface)] border border-[var(--color-line)] rounded-2xl p-5 flex items-start gap-4">
						<span
							class="flex items-center justify-center w-10 h-10 rounded-xl shrink-0"
							style={tintBg(entry.data.tint)}
						>
							<span class="material-icons text-[1.25rem]">
								{entry.data.icon}
							</span>
						</span>
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2 mb-1.5 flex-wrap">
								<span
									class="inline-block px-2 py-0.5 rounded-full text-[0.625rem] font-bold uppercase tracking-wider"
									style={tintBg(entry.data.tint)}
								>
									{entry.data.tag}
								</span>
								<span class="text-[0.6875rem] text-[var(--color-fg-muted)]">
									{formatDate(entry.data.date)}
								</span>
							</div>
							<h2 class="font-[var(--font-display)] m-0 mb-2 text-base font-semibold text-[var(--color-fg)] leading-tight">
								{entry.data.title}
							</h2>
							{entry.data.landing?.pitch && (
								<p class="m-0 text-[0.875rem] text-[var(--color-fg-secondary)] leading-relaxed">
									{entry.data.landing.pitch}
								</p>
							)}
						</div>
					</article>
				))
			}
		</div>

		<aside
			class="mt-16 rounded-3xl p-8 md:p-12 text-center overflow-hidden relative"
			style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 30px 60px -25px var(--color-brand-glow);"
		>
			<div
				class="absolute -top-24 -right-24 w-64 h-64 rounded-full blur-3xl opacity-30 pointer-events-none"
				style="background: white;"
				aria-hidden="true"
			>
			</div>
			<h2
				class="relative font-[var(--font-display)] m-0 mb-3 text-2xl md:text-4xl font-bold text-white tracking-tight"
			>
				¿Quieres ser parte de esto?
			</h2>
			<p
				class="relative m-0 mb-7 text-sm md:text-base text-white/85 max-w-md mx-auto leading-relaxed"
			>
				Completr está en beta cerrada. Inscríbete con tu correo y te
				avisamos en cuanto abramos cupos.
			</p>
			<a
				href="/#beta"
				class="relative inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white text-[var(--color-brand-deep)] font-semibold text-base no-underline transition-transform hover:scale-[1.03] shadow-lg"
			>
				Inscribirme a la beta
				<span class="material-icons text-[1.125rem]">arrow_forward</span
				>
			</a>
		</aside>
	</main>
	<Footer />
</Layout>
