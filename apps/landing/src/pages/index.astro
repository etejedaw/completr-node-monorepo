---
import Layout from "../layouts/Layout.astro";

const features = [
	{
		icon: "📋",
		title: "Backlog ordenado",
		description:
			"Organiza tus pendientes, marca estatus, prioriza con tu wishlist y guarda vistas filtradas para encontrar todo en segundos."
	},
	{
		icon: "🗄️",
		title: "Game Shelf",
		description:
			"Registra los juegos que tienes (físicos o digitales), con plataforma, edición y fecha de adquisición."
	},
	{
		icon: "🔍",
		title: "Descubre",
		description:
			"Explora listas curadas oficiales y de la comunidad, géneros, juegos recién reseñados y novedades en el catálogo."
	},
	{
		icon: "👥",
		title: "Social",
		description:
			"Sigue a otros jugadores, lee reseñas honestas y comparte tu progreso en un feed de actividad."
	}
];

const screenshots = [
	{
		src: "/screenshots/feed.png",
		alt: "Feed de actividad",
		caption: "Feed: la actividad de quienes sigues"
	},
	{
		src: "/screenshots/games.png",
		alt: "Página de juegos",
		caption: "Games: descubre con shelves y juegos destacados"
	},
	{
		src: "/screenshots/backlog.png",
		alt: "Backlog con ratios",
		caption: "Backlog: tus pendientes con el ratio destacado"
	},
	{
		src: "/screenshots/profile.png",
		alt: "Perfil con stats",
		caption: "Perfil: stats, listas, reseñas y actividad"
	}
];
---

<Layout>
	<main class="relative overflow-hidden">
		<section
			class="relative min-h-screen flex flex-col items-center justify-center px-6 text-center"
		>
			<div
				class="absolute -top-1/3 left-1/2 -translate-x-1/2 w-[900px] h-[900px] rounded-full blur-3xl opacity-30 pointer-events-none"
				style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
				aria-hidden="true"
			>
			</div>

			<div class="relative z-10 max-w-2xl flex flex-col items-center gap-6">
				<div class="flex items-center gap-3">
					<span
						class="flex items-center justify-center w-12 h-12 rounded-xl font-display font-extrabold text-xl text-white"
						style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 8px 24px -4px var(--color-brand-glow);"
					>
						C
					</span>
					<span
						class="text-3xl md:text-4xl font-bold tracking-tight font-[var(--font-display)]"
					>
						Completr
					</span>
				</div>

				<span
					class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-[var(--color-brand)]/15 text-[var(--color-brand)] border border-[var(--color-brand)]/30"
				>
					<span
						class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] animate-pulse"
					></span>
					Beta privada
				</span>

				<h1
					class="font-[var(--font-display)] m-0 text-4xl md:text-6xl font-bold tracking-tight leading-[1.05]"
				>
					Estamos afinando los
					<span
						class="bg-clip-text text-transparent"
						style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
						>últimos detalles</span
					>.
				</h1>

				<p
					class="m-0 text-base md:text-lg text-[var(--color-fg-secondary)] leading-relaxed max-w-xl"
				>
					Tu backlog crece más rápido que tu tiempo libre. Completr ordena
					lo que tienes pendiente y te dice qué vale la pena jugar a
					continuación. Próximamente abrimos <strong
						class="text-[var(--color-fg)]">beta cerrada</strong
					>.
				</p>
			</div>

			<a
				href="#features"
				class="absolute bottom-10 z-10 text-[var(--color-fg-muted)] hover:text-[var(--color-brand)] transition-colors flex flex-col items-center gap-1 no-underline"
				aria-label="Ver más"
			>
				<span class="text-xs uppercase tracking-wider">Conocer más</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="animate-bounce"
				>
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</a>
		</section>

		<section
			id="features"
			class="relative py-24 px-6 border-t border-[var(--color-line)] overflow-hidden"
		>
			<div
				class="absolute top-1/2 -translate-y-1/2 -left-40 w-[500px] h-[500px] rounded-full blur-3xl opacity-20 pointer-events-none"
				style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
				aria-hidden="true"
			>
			</div>

			<div
				class="relative max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-16 items-center"
			>
				<div>
					<span
						class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand)]"
						>El Ratio</span
					>
					<h2
						class="font-[var(--font-display)] mt-3 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight"
					>
						Lo que separa a
						<span
							class="bg-clip-text text-transparent"
							style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
							>Completr</span
						>.
					</h2>
					<p
						class="m-0 text-[var(--color-fg-secondary)] leading-relaxed mb-3"
					>
						El <strong class="text-[var(--color-fg)]">Ratio</strong> responde
						la pregunta que abre tu backlog cada noche: <em>¿qué juego ahora?</em>
						Combina la calificación de la comunidad con el tiempo promedio
						para terminarlo, en una sola métrica que premia los juegos que te
						dan más por cada hora que les inviertes.
					</p>
					<p
						class="m-0 text-[var(--color-fg-secondary)] leading-relaxed"
					>
						Un 95 de 12 horas no pesa igual que un 95 de 80 horas. Uno cabe
						en una semana; el otro te pide medio mes. El Ratio te lo deja
						claro de un vistazo para que ordenes tu backlog según tu tiempo
						real, no según el hype.
					</p>
				</div>

				<div class="relative">
					<div
						class="relative max-w-sm mx-auto rounded-2xl p-6 border-2 border-[var(--color-brand)] overflow-hidden"
						style="background: linear-gradient(160deg, rgba(139, 92, 246, 0.18), transparent 60%), var(--color-surface);"
					>
						<div class="flex items-center gap-2 mb-4">
							<span
								class="flex items-center justify-center w-7 h-7 rounded-md font-display font-extrabold text-xs text-white"
								style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));"
								>C</span
							>
							<span
								class="text-[0.6875rem] font-bold uppercase tracking-wider text-[var(--color-brand)]"
								>Completr Score</span
							>
						</div>

						<div class="flex items-baseline gap-2 mb-1">
							<span class="text-6xl font-bold text-[var(--color-brand)] leading-none"
								>87.5</span
							>
							<span class="text-xs uppercase tracking-wider text-[var(--color-fg-muted)]"
								>Ratio</span
							>
						</div>
						<p class="m-0 mt-1 text-[0.6875rem] text-[var(--color-fg-muted)] leading-snug">
							score relative to time invested by the community
						</p>

						<div
							class="mt-4 pt-4 border-t border-[var(--color-line)]/60 flex flex-col gap-2.5"
						>
							<div class="flex items-center justify-between">
								<span
									class="text-[0.6875rem] uppercase tracking-wider text-[var(--color-fg-muted)]"
									>Rating</span
								>
								<div class="flex items-center gap-1">
									<span class="text-[var(--color-brand)]">★★★★</span>
									<span class="text-[var(--color-fg-muted)]">★</span>
								</div>
							</div>
							<div class="flex items-center justify-between">
								<span
									class="text-[0.6875rem] uppercase tracking-wider text-[var(--color-fg-muted)]"
									>Duration</span
								>
								<span class="text-sm font-semibold text-[var(--color-fg)]"
									>18h <span class="text-[0.625rem] font-normal text-[var(--color-fg-muted)]">avg</span></span
								>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section
			id="features-grid"
			class="relative py-24 px-6 border-t border-[var(--color-line)]"
		>
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-14 max-w-2xl mx-auto">
					<span
						class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand)]"
						>Qué trae Completr</span
					>
					<h2
						class="font-[var(--font-display)] mt-3 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight"
					>
						Para
						<span
							class="bg-clip-text text-transparent"
							style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
							>disfrutar</span
						> cada juego que empiezas y poder
						<span
							class="bg-clip-text text-transparent"
							style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
							>terminarlo</span
						>.
					</h2>
					<p class="m-0 text-[var(--color-fg-secondary)]">
						Las herramientas para organizar tu backlog, encontrar tu
						próximo juego y compartir lo que te importa.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
					{
						features.map(f => (
							<div class="group relative p-6 rounded-2xl bg-[var(--color-surface)] border border-[var(--color-line)] hover:border-[var(--color-brand)]/50 transition-colors overflow-hidden">
								<div
									class="absolute -top-12 -right-12 w-32 h-32 rounded-full blur-3xl opacity-0 group-hover:opacity-30 transition-opacity pointer-events-none"
									style="background: var(--color-brand);"
								/>
								<div class="relative">
									<span class="text-3xl block mb-3">{f.icon}</span>
									<h3 class="font-[var(--font-display)] m-0 mb-2 text-lg font-bold text-[var(--color-fg)]">
										{f.title}
									</h3>
									<p class="m-0 text-sm text-[var(--color-fg-secondary)] leading-relaxed">
										{f.description}
									</p>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section
			class="relative py-24 px-6 border-t border-[var(--color-line)]"
		>
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-14 max-w-2xl mx-auto">
					<span
						class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand)]"
						>Sneak peek</span
					>
					<h2
						class="font-[var(--font-display)] mt-3 mb-4 text-3xl md:text-5xl font-bold tracking-tight leading-tight"
					>
						Así se ve por dentro.
					</h2>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{
						screenshots.map(s => (
							<figure class="m-0 group">
								<button
									type="button"
									data-lightbox-src={s.src}
									data-lightbox-alt={s.alt}
									class="block w-full p-0 bg-transparent border-0 cursor-zoom-in text-left"
								>
									<div
										class="rounded-2xl overflow-hidden border-2 border-[var(--color-line)] bg-[#1a1a23] transition-all duration-300 group-hover:border-[var(--color-brand)]/50 group-hover:-translate-y-1"
										style="box-shadow: 0 24px 60px -24px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.03) inset;"
									>
										<div class="flex items-center gap-1.5 px-3 py-2.5 border-b border-[var(--color-line)] bg-[#0f0f15]">
											<span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]" />
											<span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]" />
											<span class="w-2.5 h-2.5 rounded-full bg-[#28c840]" />
										</div>
										<img
											src={s.src}
											alt={s.alt}
											loading="lazy"
											decoding="async"
											class="w-full h-auto block"
										/>
									</div>
								</button>
								<figcaption class="mt-3 text-sm text-[var(--color-fg-muted)] text-center">
									{s.caption}
								</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</section>

		<section
			class="relative py-20 px-6 border-t border-[var(--color-line)] text-center"
		>
			<div class="max-w-2xl mx-auto">
				<span
					class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--color-brand)]"
					>Sobre el proyecto</span
				>
				<p
					class="mt-4 m-0 text-[var(--color-fg-secondary)] leading-relaxed"
				>
					Completr empezó como un Excel donde anotaba mis juegos para no
					perder el hilo. Con el tiempo se volvió una app que armé solo para
					mí, y ahora la estoy abriendo a mis amigos y gente cercana para
					probarla y juntar feedback. Sin promesas grandes, sin roadmap
					inflado. Es solo el tracker que me hubiera gustado tener.
				</p>
				<p
					class="mt-4 m-0 text-[var(--color-fg-secondary)] leading-relaxed font-semibold"
				>
					Próximamente abrimos beta cerrada.
				</p>
				<div
					class="mt-8 inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--color-line)] bg-[var(--color-surface)] text-xs text-[var(--color-fg-muted)]"
				>
					<span>Catálogo respaldado por</span>
					<a
						href="https://rawg.io"
						target="_blank"
						rel="noopener noreferrer"
						class="font-semibold text-[var(--color-fg-secondary)] hover:text-[var(--color-brand)] transition-colors no-underline"
						>RAWG</a
					>
				</div>
			</div>
		</section>

		<footer
			class="relative py-10 px-6 border-t border-[var(--color-line)] text-center"
		>
			<div
				class="flex items-center justify-center gap-2 flex-wrap text-[0.6875rem] text-[var(--color-fg-muted)] mb-3"
			>
				<span>Built with</span>
				<span class="text-[var(--color-fg-secondary)]">Angular</span>
				<span>·</span>
				<span class="text-[var(--color-fg-secondary)]">Node</span>
				<span>·</span>
				<span class="text-[var(--color-fg-secondary)]">Postgres</span>
				<span>·</span>
				<span class="text-[var(--color-fg-secondary)]">Astro</span>
			</div>
			<div class="text-xs text-[var(--color-fg-muted)]">
				Made with ♥ by <a
					href="https://www.etejeda.dev"
					target="_blank"
					rel="noopener noreferrer"
					class="text-[var(--color-fg-secondary)] hover:text-[var(--color-brand)] transition-colors"
					>Esteban Tejeda</a
				>
			</div>
		</footer>

		<div
			id="lightbox"
			class="hidden fixed inset-0 z-[1000] bg-black/85 backdrop-blur-sm items-center justify-center p-4 md:p-10 cursor-zoom-out"
			role="dialog"
			aria-modal="true"
			aria-label="Vista ampliada"
		>
			<img
				id="lightbox-img"
				src=""
				alt=""
				class="max-w-full max-h-full w-auto h-auto rounded-lg shadow-2xl"
			/>
			<button
				type="button"
				id="lightbox-close"
				class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white border-0 cursor-pointer flex items-center justify-center text-xl backdrop-blur-md"
				aria-label="Cerrar"
			>
				✕
			</button>
		</div>
	</main>
</Layout>

<script>
	const lightbox = document.getElementById("lightbox") as HTMLDivElement;
	const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
	const closeBtn = document.getElementById("lightbox-close");

	function open(src: string, alt: string) {
		lightboxImg.src = src;
		lightboxImg.alt = alt;
		lightbox.classList.remove("hidden");
		lightbox.classList.add("flex");
		document.body.style.overflow = "hidden";
	}

	function close() {
		lightbox.classList.add("hidden");
		lightbox.classList.remove("flex");
		lightboxImg.src = "";
		document.body.style.overflow = "";
	}

	document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach(btn => {
		btn.addEventListener("click", () => {
			open(btn.dataset.lightboxSrc ?? "", btn.dataset.lightboxAlt ?? "");
		});
	});

	lightbox?.addEventListener("click", e => {
		if (e.target === lightbox) close();
	});
	closeBtn?.addEventListener("click", close);
	document.addEventListener("keydown", e => {
		if (e.key === "Escape" && !lightbox.classList.contains("hidden")) close();
	});
</script>
