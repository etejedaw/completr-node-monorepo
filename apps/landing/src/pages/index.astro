---
import BetaSignup from "../components/BetaSignup.astro";
import Changelog from "../components/Changelog.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Moods from "../components/Moods.astro";
import MoreFeatures from "../components/MoreFeatures.astro";
import OpenSource from "../components/OpenSource.astro";
import ProductTour from "../components/ProductTour.astro";
import Ratio from "../components/Ratio.astro";
import Rewind from "../components/Rewind.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
