---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Página no encontrada — Completr"
	description="Esta página no existe o se movió."
>
	<main
		class="relative min-h-screen flex flex-col items-center justify-center px-6 text-center overflow-hidden"
	>
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full blur-3xl opacity-25 pointer-events-none"
			style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
			aria-hidden="true"
		>
		</div>

		<div class="relative z-10 max-w-xl flex flex-col items-center gap-6">
			<span
				class="font-[var(--font-display)] text-7xl md:text-9xl font-bold tracking-tight bg-clip-text text-transparent leading-none"
				style="background-image: linear-gradient(135deg, var(--color-brand), #c4a8ff);"
				>404</span
			>
			<h1
				class="font-[var(--font-display)] m-0 text-2xl md:text-4xl font-bold tracking-tight"
			>
				Esta página no existe.
			</h1>
			<p
				class="m-0 text-[var(--color-fg-secondary)] leading-relaxed max-w-md"
			>
				O se movió, o el link estaba mal escrito. Vuelve al inicio para
				inscribirte a la beta.
			</p>

			<a
				href="/"
				class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-semibold text-white no-underline transition-transform hover:-translate-y-0.5"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 8px 24px -4px var(--color-brand-glow);"
			>
				Ir al inicio
			</a>
		</div>
	</main>
</Layout>
