---
import { getRelativeLocaleUrl } from "astro:i18n";

import {
	getLocaleStaticPaths,
	type Locale,
	toLocale
} from "../../i18n/locales";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = getLocaleStaticPaths;

const lang = toLocale(Astro.currentLocale);

const copy = {
	es: {
		pageTitle: "¡Listo! — Completr",
		description: "Tu pedido de invitación a Completr quedó registrado.",
		heading: "Recibí tu correo.",
		message: "Te escribo con tu invitación.",
		back: "← Volver al inicio"
	},
	en: {
		pageTitle: "Done! — Completr",
		description: "Your invitation request to Completr was received.",
		heading: "Got your email.",
		message: "I'll write to you with your invitation.",
		back: "← Back to home"
	}
} satisfies Record<Locale, unknown>;

const t = copy[lang];
---

<Layout title={t.pageTitle} description={t.description} noindex>
	<main
		id="main-content"
		class="relative min-h-screen flex flex-col items-center justify-center px-6 text-center"
	>
		<div
			class="absolute -top-1/3 left-1/2 -translate-x-1/2 w-[900px] h-[900px] rounded-full blur-3xl opacity-30 pointer-events-none"
			style="background: radial-gradient(circle, var(--color-brand) 0%, transparent 60%);"
			aria-hidden="true"
		>
		</div>

		<div class="relative z-10 max-w-xl flex flex-col items-center gap-6">
			<span
				class="flex items-center justify-center w-16 h-16 rounded-2xl text-white"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 12px 32px -6px var(--color-brand-glow);"
				aria-hidden="true"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="32"
					height="32"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<polyline points="20 6 9 17 4 12"></polyline>
				</svg>
			</span>

			<h1
				class="font-[var(--font-display)] m-0 text-4xl md:text-5xl font-bold tracking-tight leading-[1.1]"
			>
				{t.heading}
			</h1>

			<p
				class="m-0 text-base md:text-lg text-[var(--color-fg-secondary)] leading-relaxed"
			>
				{t.message}
			</p>

			<a
				href={getRelativeLocaleUrl(lang)}
				class="mt-4 inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-white no-underline transition-transform hover:-translate-y-0.5"
				style="background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep)); box-shadow: 0 8px 24px -4px var(--color-brand-glow);"
			>
				{t.back}
			</a>
		</div>
	</main>
</Layout>
