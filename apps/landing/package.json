{
	"name": "completr-page-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"lint": "eslint . --fix",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
