		"*.{js,mjs,cjs,ts,astro,css,json,md}": "prettier --write"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/compiler": "^2.13.1",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.1",
		"astro": "^7.2.2",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	},
	"allowScripts": {
		"esbuild": false,
		"fsevents": false
	}
