{
	"name": "@completr/api",
	"private": true,
	"description": "Backend for Completr, a game backlog tracker with ratio-based prioritization",
	"homepage": "https://www.completr.app",
	"bugs": {
		"url": "https://github.com/etejedaw/completr-node-monorepo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/etejedaw/completr-node-monorepo.git",
		"directory": "apps/api"
	},
	"license": "AGPL-3.0",
	"author": "Esteban Tejeda <contacto@etejeda.dev> (https://www.etejeda.dev)",
	"type": "commonjs",
	"scripts": {
		"start": "node dist/src/app.js",
		"start:dev": "node --watch -r ts-node/register --env-file-if-exists=.env.dev.local ./src/app.ts",
		"start:prod": "node --watch -r ts-node/register --env-file=.env.prod.local ./src/app.ts",
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p . --noEmit",
		"test": "npm run test:unit && npm run test:integration",
		"test:unit": "NODE_ENV=test node --env-file-if-exists=.env.test.local -r ts-node/register --test \"test/**/*.unit.test.ts\"",
		"test:integration": "NODE_ENV=test node --env-file-if-exists=.env.test.local -r ts-node/register --test --test-concurrency=1 --test-global-setup=test/global-setup.mjs \"test/**/*.integration.test.ts\"",
		"migrate:dev": "node --env-file-if-exists=.env.dev.local ../../node_modules/.bin/sequelize-cli db:migrate --env dev",
		"migrate:undo:dev": "node --env-file-if-exists=.env.dev.local ../../node_modules/.bin/sequelize-cli db:migrate:undo --env dev",
		"migrate:status:dev": "node --env-file-if-exists=.env.dev.local ../../node_modules/.bin/sequelize-cli db:migrate:status --env dev",
		"migrate:prod": "node --env-file=.env.prod.local ../../node_modules/.bin/sequelize-cli db:migrate --env prod",
		"migrate:undo:prod": "node --env-file=.env.prod.local ../../node_modules/.bin/sequelize-cli db:migrate:undo --env prod",
		"migrate:status:prod": "node --env-file=.env.prod.local ../../node_modules/.bin/sequelize-cli db:migrate:status --env prod",
		"migrate:create": "node --env-file-if-exists=.env.dev.local ../../node_modules/.bin/sequelize-cli migration:generate --name",
		"create:admin": "node dist/scripts/create-admin.js",
		"seed:dev": "node -r ts-node/register --env-file-if-exists=.env.dev.local ./scripts/seed-dev.ts"
	},
	"dependencies": {
		"@fontsource/chakra-petch": "^5.3.0",
		"@fontsource/manrope": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"nodemailer": "^10.1.7",
		"openai": "^7.45.1",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.2",
		"rate-limiter-flexible": "^8.3.0",
		"satori": "^0.63.2",
		"sequelize": "^6.37.7",
		"slugify": "^1.6.6",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/nodemailer": "^8.0.2",
		"@types/supertest": "^7.2.1",
		"sequelize-cli": "^6.6.5",
		"supertest": "^7.3.1",
		"ts-node": "^10.9.2"
	}
}
