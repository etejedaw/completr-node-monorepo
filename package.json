{
	"name": "completr-node-backend",
	"version": "1.0.0",
	"description": "Backend for Completr, a game backlog tracker with ratio-based prioritization",
	"homepage": "https://completr.app",
	"bugs": {
		"url": "https://github.com/etejedaw/completr-node-backend/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/etejedaw/completr-node-backend.git"
	},
	"license": "AGPL-3.0",
	"author": "Esteban Tejeda <etejedaw@hotmail.com> (https://etejeda.dev)",
	"type": "commonjs",
	"main": "index.js",
	"scripts": {
		"start": "node dist/app.js",
		"start:dev": "node --watch -r ts-node/register --env-file=.env ./src/app.ts",
		"start:stg": "node --watch -r ts-node/register --env-file=.env.staging.local ./src/app.ts",
		"start:prod": "node --watch -r ts-node/register --env-file=.env.production.local ./src/app.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"build": "tsc -p .",
		"typecheck": "tsc -p . --noEmit",
		"migrate": "node --env-file=.env node_modules/.bin/sequelize-cli db:migrate",
		"migrate:undo": "node --env-file=.env node_modules/.bin/sequelize-cli db:migrate:undo",
		"migrate:create": "node --env-file=.env node_modules/.bin/sequelize-cli migration:generate --name",
		"migrate:status": "node --env-file=.env node_modules/.bin/sequelize-cli db:migrate:status"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"express": "^5.1.0",
		"express-xss-sanitizer": "^2.0.2",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"pino": "^10.1.0",
		"pino-pretty": "^13.1.2",
		"rate-limiter-flexible": "^8.3.0",
		"sequelize": "^6.37.7",
		"slugify": "^1.6.6",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.5",
		"@types/express-xss-sanitizer": "^2.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "3.7.4",
		"sequelize-cli": "^6.6.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.51.0"
	}
}
