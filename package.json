{
	"name": "completr",
	"version": "0.4.0",
	"private": true,
	"description": "Completr, a game backlog tracker with ratio-based prioritization",
	"homepage": "https://www.completr.app",
	"bugs": {
		"url": "https://github.com/etejedaw/completr-node-monorepo/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/etejedaw/completr-node-monorepo.git"
	},
	"license": "AGPL-3.0",
	"author": "Esteban Tejeda <contacto@etejeda.dev> (https://www.etejeda.dev)",
	"packageManager": "npm@11.11.0",
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"dev": "concurrently -k -n api,web -c blue,magenta \"npm run start:dev -w apps/api\" \"npm start -w apps/web\"",
		"dev:api": "npm run start:dev -w apps/api",
		"dev:web": "npm start -w apps/web",
		"dev:landing": "npm run dev -w apps/landing",
		"db": "docker compose -f apps/api/docker-compose.yml up -d",
		"db:down": "docker compose -f apps/api/docker-compose.yml down",
		"build": "npm run build --workspaces",
		"build:api": "npm run build -w apps/api",
		"build:web": "npm run build -w apps/web",
		"build:landing": "npm run build -w apps/landing",
		"typecheck": "npm run typecheck -w apps/api -w apps/landing",
		"test": "npm run test -w apps/web",
		"migrate": "npm run migrate -w apps/api",
		"migrate:status": "npm run migrate:status -w apps/api",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,js,mjs,html,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json,md,yml,yaml}": [
			"prettier --write"
		]
	},
	"overrides": {
		"sanitize-html": "^2.17.4",
		"uuid": "^11.1.1"
	},
	"allowScripts": {
		"bcrypt": false,
		"esbuild": false,
		"@parcel/watcher": false,
		"fsevents": false,
		"lmdb": false,
		"msgpackr-extract": false
	},
	"devDependencies": {
		"@astrojs/compiler": "^2.13.1",
		"@eslint/js": "^10.0.1",
		"angular-eslint": "^22.0.0",
		"concurrently": "^10.0.5",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
